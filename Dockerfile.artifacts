FROM final-g03-spark:latest
RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer libreoffice-impress poppler-utils fonts-dejavu fonts-liberation \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir python-docx==1.2.0 reportlab==4.4.5 pdf2image==1.17.0 pymupdf==1.26.6
ENV MPLBACKEND=Agg PYTHONUNBUFFERED=1
WORKDIR /workspace
